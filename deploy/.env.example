# Copy to .env next to docker-compose.yml and fill in the required values.

# Image tag: "latest" follows main; pin a release such as 1.2.0 for stability.
BATTLE_LIBRARY_VERSION=latest

# Host port the app is served on.
HTTP_PORT=8080

# Required. Database password, letters and digits only (e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=

# Required. Token signing key, at least 32 characters (e.g. openssl rand -hex 32).
# Changing it signs everyone out.
JWT_KEY=

# Optional. Email that can always register and becomes admin.
# The first account on a fresh database becomes admin either way.
ADMIN_EMAIL=

# Optional. Public base URL, e.g. https://battle.example.com (no trailing slash).
# Only needed when a reverse proxy hides the original scheme or host.
PUBLIC_URL=

# Optional. Ships logs to Axiom; console logging only when empty.
AXIOM_TOKEN=
