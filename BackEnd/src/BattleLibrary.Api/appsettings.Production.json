{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "battle-library",
    "Audience": "battle-library",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Axiom": {
    "Dataset": "battle-library"
  }
}
