# Base URL of the Battle Library API (no trailing slash).
# Local development:
VITE_API_BASE_URL=http://localhost:5080

# Production is supplied at build time (e.g. the deployed Railway API URL).
# VITE_API_BASE_URL=https://your-api.up.railway.app

# Pages subpath for production builds, e.g. /battle-library/ for a project site.
# VITE_BASE=/
